@model PoliticalWebsite.Models.YouthConversation

@{
    ViewBag.Title = "YouthConversation";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}


@if (TempData["YouthConversation"] != null)
{
    var messageType = TempData["MessageType"]?.ToString() ?? "info";

    <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
        @TempData["YouthConversation"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!--=====================================
 Youth Dialogue Registration Form Start
======================================-->
<section id="youthRegistration" class="youth-registration-section">
    <!-- Background Shapes -->
    <div class="bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
    </div>

    <div class="container">
        <div class="row">

            <!-- Top Center Heading -->
            <div class="col-12">
                <div class="registration-header text-center">
                    <div class="header-icon">
                        <img src="/AssetsNew/images/favicon.png" alt="BJP" class="bjp-logo">
                    </div>
                    <span class="tag">युवा संवाद 2026</span>
                    <h2>अपनी आवाज़, <span>अपना भविष्य</span></h2>
                    <p>युवाओं के विचारों को सुनने और उन्हें एक मंच देने के लिए<br>हमारे इस विशेष कार्यक्रम में पंजीकरण करें।</p>

                    <div class="event-info">
                        <div class="info-item">
                            <i class="fas fa-calendar-alt"></i>
                            <span>15 दिसंबर 2024</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-clock"></i>
                            <span>सुबह 10:00 बजे</span>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>देवरिया, उत्तर प्रदेश</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Left: Form | Right: Image -->
            <div class="col-lg-7">
                <div class="registration-form-wrapper">

                    @using (Html.BeginForm("YouthConversation", "Home", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
                    {
                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        पूरा नाम <span class="required">*</span>
                                    </label>
                                    @*<input type="text" class="form-control" placeholder="अपना पूरा नाम दर्ज करें" required>*@
                                    @Html.TextBoxFor(m => m.FullName, new
                               {
                                   @class = "form-control",
                                   @placeholder = "पूरा नाम (Full Name)",
                                   required = "required"
                               })
                                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Father Name -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        पिता / अभिभावक का नाम <span class="required">*</span>
                                    </label>
                                    @*<input type="text" class="form-control" placeholder="पिता / अभिभावक का नाम" required>*@
                                    @Html.TextBoxFor(m => m.FatherName, new
                               {
                                   @class = "form-control",
                                   @placeholder = "पिता / अभिभावक का नाम (Father / Guardian Name)",
                                   required = "required"

                               })
                                    @Html.ValidationMessageFor(m => m.FatherName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Age -->
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">
                                        आयु <span class="required">*</span>
                                    </label>
                                    @*<input type="number" class="form-control" placeholder="उदा. 18" min="10" max="35" required>*@
                                    @Html.TextBoxFor(m => m.Age, new
                               {
                                        @class = "form-control",
                                        @placeholder = "आयु (Age)",
                                        @onkeypress = "return isNumberOrDecimal(event);",
                                   required = "required"
                               })
                                    @Html.ValidationMessageFor(m => m.Age, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Mobile -->
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">
                                        मोबाइल नंबर <span class="required">*</span>
                                    </label>
                                    @*<input type="tel" class="form-control" placeholder="10 अंकों का मोबाइल नंबर" pattern="[0-9]{10}" required>*@
                                    @Html.TextBoxFor(m => m.MobileNo, new
                               {
                                   @class = "form-control",
                                   @placeholder = "मोबाइल नंबर (Mobile No)",
                                   @onkeypress = "return isNumberOrDecimal(event);",
                                   @maxlength = "10",
                                   required = "required"
                               })
                                    @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">
                                        ईमेल <span class="optional">(वैकल्पिक)</span>
                                    </label>
                                    @*<input type="email" class="form-control" placeholder="your@email.com">*@
                                    @Html.TextBoxFor(m => m.Email, new
                               {
                                   @class = "form-control",
                                   @placeholder = "ईमेल (Email - Optional)",
                                   @type = "email",
                                   required = "required"
                               })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Address -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        स्थानीय पता / गांव <span class="required">*</span>
                                    </label>
                                    @*<input type="text" class="form-control" placeholder="गांव / मोहल्ला का नाम" required>*@
                                    @Html.TextBoxFor(m => m.Address, new
                               {
                                   @class = "form-control",
                                   @placeholder = "स्थानीय पता / गांव / वार्ड नाम (Local Address)",
                                   required = "required"
                               })
                                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- District -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        जिला <span class="required">*</span>
                                    </label>
                                    @*<select class="form-select" required>
                                            <option value="">-- जिला चुनें --</option>
                                            <option value="deoria">देवरिया</option>
                                            <option value="gorakhpur">गोरखपुर</option>
                                            <option value="maharajganj">महाराजगंज</option>
                                            <option value="kushinagar">कुशीनगर</option>
                                            <option value="other">अन्य</option>
                                        </select>*@
                                    @Html.DropDownListFor(m => m.District,
                            new List<SelectListItem>
                            {
                                new SelectListItem { Text = "-- जिला चुनें --", Value = "" },
                                new SelectListItem { Text = "देवरिया", Value = "Deoria" },
                                new SelectListItem { Text = "गोरखपुर", Value = "Gorakhpur" },
                                new SelectListItem { Text = "महाराजगंज", Value = "Maharajganj" },
                                new SelectListItem { Text = "कुशीनगर", Value = "Kushinagar" },
                                new SelectListItem { Text = "अन्य", Value = "Other" }
                            },
                            new
                            {
                                @class = "form-select",
                                required = "required"
                            })
                                    @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- School -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        विद्यालय / कॉलेज <span class="required">*</span>
                                    </label>
                                    @*<input type="text" class="form-control" placeholder="संस्थान का नाम" required>*@
                                    @Html.TextBoxFor(m => m.InstituteName, new { @class = "form-control", @placeholder = "विद्यालय / कॉलेज / संस्थान का नाम (School / College / Institute)" })
                                    @Html.ValidationMessageFor(m => m.InstituteName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Class -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        कक्षा / कोर्स <span class="required">*</span>
                                    </label>
                                    @*<input type="text" class="form-control" placeholder="उदा. 12वीं, B.A., B.Tech" required>*@
                                    @Html.TextBoxFor(m => m.Course, new { @class = "form-control", @placeholder = "कक्षा / कोर्स (Class / Course)" })
                                    @Html.ValidationMessageFor(m => m.Course, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Topic -->
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label">
                                        आप किस विषय पर बात करना चाहेंगे?
                                    </label>
                                    @*<textarea rows="3" class="form-control" placeholder="अपने विचार, सुझाव या प्रश्न यहाँ लिखें..."></textarea>*@

                                    @Html.TextAreaFor(m => m.Topic, new
                                        {
                                            @class = "form-control",
                                            @rows = "3",
                                            @placeholder = "अपने विचार, सुझाव या प्रश्न यहाँ लिखें..."
                                        })
                                </div>
                            </div>

                            <!-- Terms -->
                            <div class="col-12">
                                <div class="form-group">
                                    @*<input class="form-check-input me-2 mt-0" type="checkbox" id="termsCheck" required>*@
                                    @Html.CheckBoxFor(m => m.IsConfirmed, new
                               {
                                   @class = "form-check-input me-2 mt-0",
                                   required = "required"
                               })

                                    <label class="form-check-label">
                                        मैं पुष्टि करता हूँ कि मेरी सभी जानकारी सही है।
                                    </label>

                                </div>
                            </div>

                            <!-- Submit -->
                            <div class="col-12 text-center">
                                <button type="submit"
                                        class="btn-submit">
                                    <span>पंजीकरण करें</span>
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                                <p class="secure-text">
                                    <i class="fas fa-lock"></i> आपकी जानकारी सुरक्षित है
                                </p>
                            </div>

                        </div>

                    }
                </div>
            </div>

            <!-- Right Side Image -->
            <div class="col-lg-5">
                <div class="registration-image-wrapper">
                    <div class="image-card">
                        <img src="/AssetsNew/images/youva_samvad.jpg" alt="सुरेछ चौरसिया" class="main-image">
                        <div class="image-overlay">
                            <div class="overlay-content">
                                <h4>सुरेन्द्र चौरसिया</h4>
                                <p>विधायक, 339- विधानसभा रामपुर कारखाना (देवरिया)</p>
                                <div class="overlay-divider"></div>
                                <div class="overlay-tagline">"जनता की सेवा ही हमारा धर्म"</div>
                            </div>
                        </div>
                        <div class="image-badge">
                            <span>भारतीय जनता पार्टी</span>
                        </div>
                        <div class="floating-badge floating-badge-1">
                            <i class="fas fa-users"></i>
                            <span>500+ युवा</span>
                        </div>
                        <div class="floating-badge floating-badge-2">
                            <i class="fas fa-calendar-check"></i>
                            <span>15 दिसंबर</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Contact -->
            <div class="col-12">
                <div class="registration-footer text-center">
                    <p>
                        <i class="fas fa-phone-alt"></i>
                        अधिक जानकारी के लिए:
                        <a href="tel:+919415964410">+91 94159 64410</a>
                    </p>
                    <span class="divider-line"></span>
                    <p class="count-text">
                        <i class="fas fa-users"></i> 500+ युवा पहले ही पंजीकृत हो चुके हैं
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!--=====================================
 Youth Dialogue Registration Form End
======================================-->
<!--=====================================
 Youth Conversation Modal Start
======================================-->
<div class="modal fade" id="windowTopModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative rounded-4 border-0 shadow-lg" id="youthModalContent">

            <!-- Close Button -->
            <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>

            <!-- Modal Body -->
            <div class="modal-body p-0">

                <!-- Header Section -->
                <div class="modal-header-section" id="modalHeaderSection">
                    <div class="header-badge">
                        <span>राष्ट्रीय युवा दिवस 2026</span>
                    </div>
                    <h3 class="modal-title">
                        युवा संवाद कार्यक्रम 🌟
                    </h3>
                    <p class="modal-subtitle">
                        <i class="fas fa-quote-left"></i>
                        स्वामी विवेकानंद जी की जयंती पर समर्पित
                        <i class="fas fa-quote-right"></i>
                    </p>
                    <div class="modal-event-meta">
                        <span class="meta-item">
                            <i class="fas fa-calendar-alt"></i> 12 जनवरी 2026
                        </span>
                        <span class="meta-item">
                            <i class="fas fa-clock"></i> सुबह 10:00 बजे
                        </span>
                        <span class="meta-item">
                            <i class="fas fa-map-marker-alt"></i> देवरिया, उत्तर प्रदेश
                        </span>
                        <span class="meta-item highlight">
                            <i class="fas fa-users"></i> सीमित सीटें
                        </span>
                    </div>
                </div>

                <!-- Content Section -->
                <div class="modal-content-section" id="modalContentSection">

                    <!-- आयोजन -->
                    <div class="event-type-badge">
                        <i class="fas fa-calendar-day"></i>
                        एक दिवसीय युवा संवाद कार्यक्रम
                    </div>

                    <!-- उद्देश्य -->
                    <div class="purpose-section">
                        <h5 class="section-title">
                            <span class="title-icon">🟠</span> कार्यक्रम का उद्देश्य
                        </h5>
                        <p class="purpose-text">
                            आज का युवा केवल देश का भविष्य ही नहीं, बल्कि वर्तमान की सबसे
                            बड़ी शक्ति है। राष्ट्रीय युवा दिवस के अवसर पर आयोजित यह
                            <strong>“युवा संवाद कार्यक्रम”</strong> युवाओं को शिक्षा, कौशल,
                            शासन-प्रशासन, प्रतियोगी परीक्षाओं, समाज सेवा, यातायात अनुशासन
                            एवं डिजिटल जिम्मेदारी जैसे विषयों पर जागरूक और सशक्त बनाने
                            का एक सशक्त मंच है।
                        </p>
                    </div>

                    <!-- Quote -->
                    <div class="quote-box" id="quoteBox">
                        <div class="quote-icon">
                            <i class="fas fa-quote-left"></i>
                        </div>
                        <div class="quote-content">
                            <p class="quote-text">
                                “उठो, जागो और तब तक मत रुको जब तक लक्ष्य प्राप्त न हो जाए”
                            </p>
                            <p class="quote-author">— स्वामी विवेकानंद</p>
                        </div>
                        <div class="quote-icon quote-icon-right">
                            <i class="fas fa-quote-right"></i>
                        </div>
                    </div>

                    <!-- Topics -->
                    <h5 class="section-title">
                        <span class="title-icon">🗂️</span> संवाद के प्रमुख विषय
                    </h5>

                    <div class="topics-grid">
                        <!-- Topic 1 -->
                        <div class="topic-card">
                            <div class="topic-number">01</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-graduation-cap"></i> शिक्षा एवं कौशल विकास
                                </h6>
                                <ul class="topic-list">
                                    <li>डिग्री के साथ स्किल का महत्व</li>
                                    <li>रोजगारपरक शिक्षा, स्टार्टअप व आत्मनिर्भरता</li>
                                    <li>ग्रामीण एवं सेमी-अर्बन युवाओं के अवसर</li>
                                </ul>
                            </div>
                        </div>


                        <!-- Topic 2 -->
                        <div class="topic-card">
                            <div class="topic-number">02</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-landmark"></i> शासन, प्रशासन एवं सरकारी योजनाएँ
                                </h6>
                                <ul class="topic-list">
                                    <li>सरकार कैसे काम करती है – व्यावहारिक जानकारी</li>
                                    <li>सरकारी योजनाओं का लाभ कैसे लें</li>
                                    <li>नीति निर्माण में युवाओं की भूमिका</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Topic 3 -->
                        <div class="topic-card">
                            <div class="topic-number">03</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-book-open"></i> प्रतियोगी परीक्षाओं पर संवाद
                                </h6>
                                <ul class="topic-list">
                                    <li>UPSC, PCS, SSC, Police, Banking की रणनीति</li>
                                    <li>समय प्रबंधन व मानसिक संतुलन</li>
                                    <li>असफलता से सीख और निरंतर प्रयास</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Topic 4 -->
                        <div class="topic-card">
                            <div class="topic-number">04</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-hand-holding-heart"></i> समाज सेवा एवं सोशल वर्क
                                </h6>
                                <ul class="topic-list">
                                    <li>नेतृत्व विकास में समाज सेवा की भूमिका</li>
                                    <li>NGO एवं स्वयंसेवी संगठनों में भागीदारी</li>
                                    <li>"राष्ट्र निर्माण = समाज सेवा"</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Topic 5 -->
                        <div class="topic-card">
                            <div class="topic-number">05</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-traffic-light"></i> यातायात नियम व सड़क सुरक्षा
                                </h6>
                                <ul class="topic-list">
                                    <li>जीवन सुरक्षा ही सर्वोपरि</li>
                                    <li>ट्रैफिक अनुशासन की जिम्मेदारी</li>
                                    <li>हेलमेट, सीट बेल्ट, गति सीमा का महत्व</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Topic 6 -->
                        <div class="topic-card">
                            <div class="topic-number">06</div>
                            <div class="topic-content">
                                <h6 class="topic-title">
                                    <i class="fas fa-share-alt"></i> सोशल मीडिया एवं डिजिटल जिम्मेदारी
                                </h6>
                                <ul class="topic-list">
                                    <li>फेक न्यूज़ से सावधानी</li>
                                    <li>डिजिटल शिष्टाचार (Digital Discipline)</li>
                                    <li>सोशल मीडिया का सकारात्मक उपयोग</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Line -->
                    <div class="modal-footer-line">
                        <i class="fas fa-star"></i>
                        युवाओं से संवाद ही राष्ट्र निर्माण की सबसे मजबूत नींव है।
                        <i class="fas fa-star"></i>
                    </div>

                    <!-- Action Buttons -->
                    <div class="modal-action-buttons">
                        <a href="#" class="btn-register">
                            <i class="fas fa-pencil-alt"></i>
                            पंजीकरण करें
                        </a>
                        <button type="button" class="btn-close-modal" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i>
                            बंद करें
                        </button>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
<!--=====================================
 Youth Conversation Modal End
======================================-->
<script>
    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
