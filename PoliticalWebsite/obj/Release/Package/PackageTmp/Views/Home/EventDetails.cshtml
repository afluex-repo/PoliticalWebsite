@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "EventDetails";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}


<!-- Page Header Start -->
<div class="page-header parallaxie">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">

                <!-- Page Header Box Start -->
                <div class="page-header-box">

                    <h1 class="text-anime-style-2" data-cursor="-opaque">
                        आयोजन विवरण
                    </h1>

                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">

                            <li class="breadcrumb-item">
                                <a href="/Home/Index">होम</a>
                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                आयोजन विवरण
                            </li>

                        </ol>
                    </nav>

                </div>
                <!-- Page Header Box End -->

            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Page Single Post Start -->
<div class="page-single-post">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">

                <!-- Post Featured Image Start -->
                <div class="post-image">
                    <figure class="image-anime reveal">

                        <img src="@Model.EventImage"
                             alt="@Model.EventsHeading"
                             class="img-fluid">

                    </figure>
                </div>
                <!-- Post Featured Image End -->
                <!-- Post Single Content Start -->
                <div class="post-content">

                    <!-- Post Entry Start -->
                    <div class="post-entry">

                        <!-- Event Heading -->
                        @if (!string.IsNullOrEmpty(Model.EventsHeading))
                        {
                            <h2 class="wow fadeInUp">
                                <strong>@Model.EventsHeading</strong>
                            </h2>
                        }


                        <!-- Event Description -->
                        @if (!string.IsNullOrEmpty(Model.Discription))
                        {
                            <p class="wow fadeInUp" data-wow-delay="0.2s">
                                @Model.Discription
                            </p>
                        }

                    </div>
                    <!-- Post Entry End -->

                </div>
                <!-- Post Single Content End -->

            </div>
        </div>
    </div>
</div>
<!-- Page Single Post End -->