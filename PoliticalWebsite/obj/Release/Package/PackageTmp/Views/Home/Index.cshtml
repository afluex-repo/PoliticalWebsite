@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}





<!-- Hero Section Start -->
<div class="hero hero-video hero-slider-layout">
    <div class="swiper">
        <div class="swiper-wrapper">
            @if (Model.lstSliderBanner != null && Model.lstSliderBanner.Count > 0)
            {
                foreach (var item in Model.lstSliderBanner)
                {
                    <!-- Hero Slide Start -->
                    <div class="swiper-slide">
                        <div class="hero-slide">

                            <!-- Slider Image Start -->
                            <div class="hero-slider-image">
                                <img src="@Url.Content(item.SliderBannerImage)"
                                     alt="Slider Banner">
                            </div>
                            <!-- Slider Image End -->

                            <div class="container">
                                <div class="row align-items-center">
                                    <div class="col-lg-7">

                                        <!-- Hero Content Start -->
                                        <div class="hero-content">

                                            <!-- Section Title Start -->
                                            <div class="section-title dark-section">
                                                <h3 class="wow fadeInUp">
                                                    सुरेंद्र चौरसिया
                                                </h3>

                                                <h1 class="text-anime-style-2"
                                                    data-cursor="-opaque">
                                                    मिलकर बनाएंगे एक <span>मजबूत भविष्य</span>
                                                </h1>

                                                <p class="wow fadeInUp"
                                                   data-wow-delay="0.2s">
                                                    हमारे अभियान के केंद्र में जनता की सेवा का संकल्प है।
                                                    हमारे आंदोलन में शामिल होकर, आप सकारात्मक बदलाव लाने,
                                                    आम भलाई के लिए नीतियों को आकार देने और हमारे समुदाय
                                                    के लिए एक उज्जवल कल बनाने का हिस्सा बनेंगे।
                                                </p>
                                            </div>
                                            <!-- Section Title End -->
                                            <!-- Hero Body Start -->
                                            <div class="hero-body wow fadeInUp"
                                                 data-wow-delay="0.4s">

                                                <a href="/Home/Contact"
                                                   class="btn-default btn-highlighted">
                                                    अभियान में शामिल हों
                                                </a>

                                            </div>
                                            <!-- Hero Body End -->
                                            <!-- Hero Footer Start -->
                                            <div class="hero-footer wow fadeInUp"
                                                 data-wow-delay="0.6s">

                                                <p>
                                                    "आपकी आवाज मायने रखती है। आइए, मिलकर बदलाव लाएं।"
                                                </p>

                                            </div>
                                            <!-- Hero Footer End -->

                                        </div>
                                        <!-- Hero Content End -->

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- Hero Slide End -->
                }
            }

        </div>


    </div>
    <div class="hero-pagination"></div>
</div>


<!-- Hero Section End -->
<!-- About Us Section Start -->
<div class="about-us">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <!-- About Us Image Start -->
                <div class="about-us-image">
                    <!-- About Image Start -->
                    <div class="about-image">
                        <figure class="image-anime">
                            <img src="/AssetsNew/images/about-us-image.jpg" alt="">
                        </figure>
                    </div>
                    <!-- About Image End -->
                    <!-- About Image Info Start -->
                    <div class="about-image-info">
                        <h2>हमारे बारे में</h2>
                        <h3>एक बेहतर कल के लिए दूरदर्शी नेता</h3>
                        <p>- सुरेंद्र चौरसिया</p>
                    </div>
                    <!-- About Image Info End -->
                </div>
                <!-- About Us Image End -->
            </div>

            <div class="col-lg-6">
                <!-- About Us Content Start -->
                <div class="about-us-content">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <!-- <h3 class="wow fadeInUp">हमारे बारे में</h3> -->
                        <h2 class="text-anime-style-2" data-cursor="-opaque">सुरेन्द्र चौरसिया के <span>बारे में </span></h2>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">सुरेन्द्र चौरसिया जी का जन्म 22 जुलाई 1989 को देवरिया जिले के ग्राम कुशहरी में एक साधारण परिवार में हुआ था। अखिल भारतीय विद्यार्थी परिषद से जुड़कर छात्र राजनीति की शुरुआत की और फिर उत्तर प्रदेश के मुख्यमंत्री योगी आदित्यनाथ के मार्गदर्शन में हिंदुत्व की विचारधारा को अपनाते हुए हिंदू युवा वाहिनी में शामिल हो गए। सुरेन्द्र चौरसिया जी वर्तमान में 339- विधानसभा रामपुर कारखाना (देवरिया) के विधायक है </p>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">सुरेन्द्र चौरसिया जी सभी लोगों के बीच में लोकप्रिय हैं। अपने कार्यालय में चौरसिया जी जनसुनवाई करके विधानसभा के लोगो की समस्याओं का निवारण करते हैं। उनकी कार्य प्रणाली और आम आदमी के प्रति संवेदनशीलता ने उन्हें एक विशेष दर्जा दिया और उन्हें जनता के बीच जनता के नेता के रूप में बहुत लोकप्रिय बना दिया। चौरसिया जी द्वारा जनता दर्शन कार्यक्रम में आने वाले सभी लोगों तथा कुछ खास समूहों जैसे दिव्यांगों, वरिष्ठ नागरिकों व महिलाओं की समस्याओं को विशेष वरीयता दी जाती है |</p>
                    </div>
                    <!-- Section Title End -->
                    <!-- About Us List Start -->
                    <div class="about-us-list wow fadeInUp" data-wow-delay="0.4s">
                        <ul>
                            <li>सभी के लिए गुणवत्तापूर्ण शिक्षा और कौशल विकास</li>
                            <li>सस्ती स्वास्थ्य सेवा जो लोगों को मुनाफे से अधिक प्राथमिकता देती है</li>
                            <li>हर समुदाय के लिए समानता, न्याय और सुरक्षा</li>
                            <li>मजबूत, लचीला समुदायों के निर्माण के लिए बुनियादी ढांचे में निवेश</li>
                        </ul>
                    </div>
                    <!-- About Us List End -->
                    <!-- About Author Info Start -->
                    <div class="about-author-info wow fadeInUp" data-wow-delay="0.6s">
                        <h3>सुरेन्द्र चौरसिया </h3>
                        <h4 class="h6">विधायक, 339- विधानसभा रामपुर कारखाना (देवरिया) </h4>
                    </div>
                    <!-- About Author Info End -->
                </div>
                <!-- About Us Content End -->
            </div>
        </div>
    </div>
</div>
<!-- About Us Section End -->
<!-- Our Campaign Section Start -->
