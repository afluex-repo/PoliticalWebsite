@model PoliticalWebsite.Models.Master

@{
    ViewBag.Title = "SliderBannerList";
    Layout = "~/Views/Shared/Admin_LayoutPage.cshtml";
}

<form action="/Master/SliderBannerList" id="form1" method="post">

    <p style="color:red">
        <span style="color:red">@TempData["msg"]</span>
    </p>

    <div class="pcoded-inner-content">
        <div class="main-body">
            <div class="page-wrapper">
                <div class="page-body">

                    <div class="row">
                        <div class="col-md-12">

                            <div class="card">

                                <div class="card-header d-flex justify-content-between">
                                    <h4>Slider Banner List</h4>

                                    <a class="btn btn-primary btn-sm"
                                       href="/Master/AddSliderBanner">
                                        <i class="mdi mdi-plus-circle-outline"></i>
                                        Add Banner
                                    </a>
                                </div>

                                <div class="card-body">

                                    <div class="dt-responsive table-responsive">

                                        <table id="order-listing"
                                               class="table table-striped table-bordered">

                                            <thead>
                                                <tr>
                                                    <th>S No.</th>
                                                    <th>Slider Banner</th>
                                                    <th>Heading</th>
                                                    <th>Title</th>
                                                    <th>Description</th>
                                                    <th>Button Text</th>
                                                    <th>Button URL</th>
                                                    <th>Footer Text</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @if (Model != null &&
                                                     Model.lstSliderBanner != null &&
                                                     Model.lstSliderBanner.Count > 0)
                                                {
                                                    int i = 1;

                                                    foreach (var Item in Model.lstSliderBanner)
                                                    {
                                                        <tr>

                                                            <td>
                                                                @i
                                                            </td>

                                                            <!-- Image -->
                                                            <td>
                                                                <img src="@Url.Content(Item.SliderBannerImage)"
                                                                     alt="Slider Banner"
                                                                     style="width:100px;height:80px;object-fit:cover;border-radius:0px;" />
                                                            </td>

                                                            <!-- Heading -->
                                                            <td>
                                                                @Item.Heading
                                                            </td>

                                                            <!-- Title -->
                                                            <td>
                                                                @Item.Title
                                                            </td>

                                                            <!-- Description -->
                                                            <td>
                                                                @Item.Description
                                                            </td>

                                                            <!-- Button Text -->
                                                            <td>
                                                                @Item.ButtonText
                                                            </td>

                                                            <!-- Button URL -->
                                                            <td>
                                                                @Item.ButtonUrl
                                                            </td>

                                                            <!-- Footer -->
                                                            <td>
                                                                @Item.FooterText
                                                            </td>

                                                            <!-- Action -->
                                                            <td style="white-space:nowrap;">

                                                                <a class="btn btn-sm btn-info"
                                                                   href="/Master/AddSliderBanner?Id=@Item.Pk_SliderBannerId">
                                                                    Edit
                                                                </a>

                                                                <a class="btn btn-sm btn-danger"
                                                                   href="/Master/DeleteSliderBanner?Id=@Item.Pk_SliderBannerId"
                                                                   onclick="return confirm('Are you sure you want to delete this banner ?')">
                                                                    Delete
                                                                </a>

                                                            </td>

                                                        </tr>

                                                        i++;
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="9"
                                                            style="text-align:center;">
                                                            No Slider Banner Found
                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</form>