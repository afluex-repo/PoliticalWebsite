@model PoliticalWebsite.Models.Master

@{
    ViewBag.Title = "AddSliderBanner";
    Layout = "~/Views/Shared/Admin_LayoutPage.cshtml";
}



@using (Html.BeginForm("AddSliderBanner", "Master", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <span style="color: red">
                        @TempData["msg"]
                    </span><br />
                    <h3 class="card-title">Slider Banner</h3>
                    <div class="form-group">
                        <label>Upload Slider Banner <span style="color: red">*</span></label><br />
                        <input type="file" id="SliderBanner" name="SliderBanner" class="form-control" />
                    </div>

                    <label>नोट: बैनर का साइज (ऊंचाई 626 पिक्सेल और चौड़ाई 1583 पिक्सेल) होनी चाहिए, जिससे बैनर सही दिखेगा ।</label>

                    <div class="form-group">
                        <label>Heading <span style="color:red">*</span></label>
                        @Html.TextBoxFor(m => m.Heading, new
                        {
                            @class = "form-control",
                            placeholder = "Enter heading"
                        })
                    </div>

                    <div class="form-group">
                        <label>Title <span style="color:red">*</span></label>
                        @Html.TextBoxFor(m => m.Title, new
                        {
                            @class = "form-control",
                            placeholder = "Enter title"
                        })
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        @Html.TextAreaFor(m => m.Description, new
                        {
                            @class = "form-control",
                            rows = "4",
                            placeholder = "Enter description"
                        })
                    </div>

                    <div class="form-group">
                        <label>Button Text</label>
                        @Html.TextBoxFor(m => m.ButtonText, new
                        {
                            @class = "form-control",
                            placeholder = "अभियान में शामिल हों"
                        })
                    </div>

                    <div class="form-group">
                        <label>Button URL</label>
                        @Html.TextBoxFor(m => m.ButtonUrl, new
                        {
                            @class = "form-control",
                            placeholder = "/Home/Contact"
                        })
                    </div>

                    <div class="form-group">
                        <label>Footer Text</label>
                        @Html.TextBoxFor(m => m.FooterText, new
                        {
                            @class = "form-control",
                            placeholder = "Enter footer text"
                        })
                    </div>

                    <div class="form-group">
                        @Html.HiddenFor(m => m.Pk_SliderBannerId)
                        @if (string.IsNullOrEmpty(Model.Pk_SliderBannerId))
                        {
                            <input type="submit"
                                   id="btnSave"
                                   name="btnSave"
                                   class="btn btn-success pull-right"
                                   value="Save"
                                   onclick="return saveSliderBanner();" />
                        }
                        else
                        {
                            <input type="submit"
                                   id="btnUpdate"
                                   name="btnUpdate"
                                   class="btn btn-success pull-right"
                                   value="Update"
                                   onclick="return saveSliderBanner();" />
                        }
                        <a href="/Master/SliderBannerList" class="btn btn-primary pull-right">Slider Banner List</a>
                    </div>


                </div>
            </div>
        </div>
    </div>

}
<style>
    .errortext {
        border: 2px solid red !important;
    }
</style>
<script>
    function saveSliderBanner() {
        $(".errortext").removeClass("errortext");
        if ($('#SliderBanner').val() == '') {
            $("#SliderBanner").addClass('errortext');
            $('#SliderBanner').focus();
            return false;
        }
    }
</script>






