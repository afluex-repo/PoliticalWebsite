@model PoliticalWebsite.Models.Home

@{
    Layout = null;
}


<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>सुरेन्द्र चौरसिया</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="/assets/vendors/iconfonts/mdi/font/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.addons.css">
    <!-- endinject -->
    <!-- plugin css for this page -->
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <link rel="stylesheet" href="/assets/css/vertical-layout-light/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="/images/favicon.ico" />

    <style>
        /* ============================================================
           ADDITIONAL CUSTOM STYLES
           ============================================================ */

        /* ===== BASE ===== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f0f2f5;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* ===== BJP COLORS ===== */
        :root {
            --bjp-saffron: #FF9933;
            --bjp-saffron-dark: #E67A00;
            --bjp-saffron-light: #FFE0B2;
            --bjp-green: #138808;
            --bjp-green-dark: #0D6B06;
            --bjp-white: #FFFFFF;
            --bjp-gray: #6B7280;
            --bjp-gray-light: #F8F9FA;
            --bjp-gray-border: #E5E7EB;
            --bjp-text-dark: #1A1A2E;
        }

        /* ===== MAIN WRAPPER ===== */
        .container-scroller {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #FFF8F0 0%, #FFF0E0 100%);
            padding: 0;
            width: 100%;
        }

            .container-scroller .content-wrapper {
                padding: 0 !important;
                background: transparent;
                width: 100%;
            }

            .container-scroller .row {
                margin: 0;
                width: 100%;
                min-height: 100vh;
                align-items: stretch;
            }

        /* ============================================================
           LEFT SECTION - BRANDING WITH WAVE ANIMATION
           ============================================================ */
        .mla-branding-left {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 40px 35px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(145deg, #FF9933 0%, #E67A00 35%, #138808 70%, #0D6B06 100%);
            width: 100%;
        }

            /* ===== WAVE ANIMATION OVERLAY ===== */
            .mla-branding-left .wave-container {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 1;
                overflow: hidden;
                pointer-events: none;
            }

            .mla-branding-left .wave {
                position: absolute;
                bottom: -10%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: rgba(255, 255, 255, 0.03);
                border-radius: 40% 60% 30% 70% / 50% 40% 60% 50%;
                animation: waveFlow 12s ease-in-out infinite alternate;
            }

                .mla-branding-left .wave:nth-child(1) {
                    animation-duration: 14s;
                    background: rgba(255, 255, 255, 0.02);
                    border-radius: 30% 70% 40% 60% / 60% 30% 70% 40%;
                    bottom: -15%;
                    left: -40%;
                }

                .mla-branding-left .wave:nth-child(2) {
                    animation-duration: 16s;
                    background: rgba(255, 255, 255, 0.04);
                    border-radius: 50% 30% 60% 40% / 30% 60% 40% 70%;
                    bottom: -5%;
                    left: -60%;
                    animation-delay: -4s;
                }

                .mla-branding-left .wave:nth-child(3) {
                    animation-duration: 18s;
                    background: rgba(255, 255, 255, 0.015);
                    border-radius: 60% 40% 50% 30% / 40% 70% 30% 60%;
                    bottom: -20%;
                    left: -30%;
                    animation-delay: -8s;
                }

                .mla-branding-left .wave:nth-child(4) {
                    animation-duration: 20s;
                    background: rgba(255, 215, 0, 0.03);
                    border-radius: 45% 55% 35% 65% / 55% 45% 65% 35%;
                    bottom: 0%;
                    left: -70%;
                    animation-delay: -12s;
                }

        @@keyframes waveFlow {
            0% {
                transform: translate(0, 0) rotate(0deg) scale(1);
            }

            33% {
                transform: translate(30px, -20px) rotate(120deg) scale(1.05);
            }

            66% {
                transform: translate(-20px, 10px) rotate(240deg) scale(0.95);
            }

            100% {
                transform: translate(10px, -30px) rotate(360deg) scale(1.02);
            }
        }

        /* Floating shapes */
        .mla-branding-left::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -30%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 0;
        }

        .mla-branding-left::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
            border-radius: 50%;
            z-index: 0;
        }

        /* ===== LEFT CONTENT ===== */
        .mla-branding-left .mla-left-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #FFFFFF;
            width: 100%;
            max-width: 420px;
        }

        /* Logo */
        .mla-branding-left .mla-left-logo {
            margin-bottom: 20px;
            position: relative;
            display: inline-block;
        }

            .mla-branding-left .mla-left-logo img {
                max-width: 130px;
                max-height: 130px;
                object-fit: contain;
                display: inline-block;
                border-radius: 50%;
                border: 3px solid rgba(255, 255, 255, 0.2);
                padding: 10px;
                background: rgba(255, 255, 255, 0.05);
                backdrop-filter: blur(4px);
                transition: transform 0.3s ease;
                position: relative;
            }

                .mla-branding-left .mla-left-logo img:hover {
                    transform: scale(1.05);
                }

            /* Glowing ring around logo */
            .mla-branding-left .mla-left-logo::after {
                content: '';
                position: absolute;
                top: -8px;
                left: -8px;
                right: -8px;
                bottom: -8px;
                border-radius: 50%;
                border: 2px solid rgba(255, 255, 255, 0.1);
                animation: ringPulse 3s ease-in-out infinite;
            }

        @@keyframes ringPulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.3;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.8;
            }
        }

        /* Text */
        .mla-branding-left .mla-left-text h1 {
            font-size: 32px;
            font-weight: 700;
            margin: 0 0 6px 0;
            color: #FFFFFF;
            text-shadow: 0 2px 15px rgba(0, 0, 0, 0.06);
            letter-spacing: 1px;
        }

        .mla-branding-left .mla-left-text p {
            font-size: 22px;
            font-weight: 400;
            margin: 0 0 4px 0;
            color: rgba(255, 255, 255, 0.85);
            letter-spacing: 1px;
        }

        .mla-branding-left .mla-left-text span {
            font-size: 14px;
            font-weight: 300;
            color: rgba(255, 255, 255);
            letter-spacing: 4px;
            text-transform: uppercase;
            display: inline-block;
        }

        /* Left Copyright */
        .mla-branding-left .mla-left-copyright {
            position: absolute;
            bottom: 12px;
            left: 30px;
            right: 30px;
            z-index: 5;
            margin: 0;
            color: rgba(255, 255, 255, 0.25) !important;
            font-size: 11px;
            text-align: center;
            font-weight: 400;
            letter-spacing: 0.5px;
        }

        /* ============================================================
           RIGHT SECTION - LOGIN FORM
           ============================================================ */
        .mla-login-right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 30px;
            min-height: 100vh;
            background: transparent;
            width: 100%;
        }

        .auth-form-transparent {
            width: 100%;
            max-width: 420px;
            padding: 40px 35px !important;
            background: var(--bjp-white);
            border-radius: 20px;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.04), 0 20px 60px rgba(255, 153, 51, 0.06);
            border-right: 5px solid var(--bjp-saffron);
            position: relative;
            overflow: hidden;
            transition: box-shadow 0.3s ease;
        }

            .auth-form-transparent:hover {
                box-shadow: 0 8px 40px rgba(255, 153, 51, 0.10);
            }

            /* Decorative circles */
            .auth-form-transparent::before {
                content: '';
                position: absolute;
                top: -80px;
                left: -80px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgb(225, 136, 19, 0.4) 100%);
                border-radius: 50%;
            }

            .auth-form-transparent::after {
                content: '';
                position: absolute;
                bottom: -100px;
                right: -100px;
                width: 250px;
                height: 250px;
                background: radial-gradient(circle, rgba(19, 136, 8, 0.03) 0%, transparent 70%);
                border-radius: 50%;
            }

        /* ===== LOGO ===== */
        .brand-logo {
            text-align: center;
            margin-bottom: 18px;
            position: relative;
            z-index: 1;
        }

            .brand-logo img {
                max-width: 180px;
                max-height: 70px;
                object-fit: contain;
                display: inline-block;
            }

            /* ===== WELCOME TEXT ===== */
            .brand-logo + div {
                text-align: center;
                margin-bottom: 6px;
                position: relative;
                z-index: 1;
            }

                .brand-logo + div span[style*="color:red"] {
                    font-size: 13px;
                    font-weight: 500;
                    color: #dc3545 !important;
                    background: rgba(220, 53, 69, 0.06);
                    padding: 4px 16px;
                    border-radius: 20px;
                    display: inline-block;
                }

        /* ===== FORM GROUPS ===== */
        .form-group {
            margin-bottom: 18px;
            position: relative;
            z-index: 1;
        }

            .form-group label {
                display: block;
                margin-bottom: 5px;
                font-weight: 600;
                font-size: 13px;
                color: var(--bjp-text-dark);
                letter-spacing: 0.3px;
            }

        /* ===== INPUT GROUPS ===== */
        .input-group {
            display: flex;
            align-items: center;
            width: 100%;
            height: 50px;
            border: 2px solid var(--bjp-gray-border);
            border-radius: 12px;
            background: var(--bjp-gray-light);
            overflow: hidden;
            transition: all 0.3s ease;
        }

            .input-group:focus-within {
                border-color: var(--bjp-saffron);
                background: var(--bjp-white);
                box-shadow: 0 0 0 4px rgba(255, 153, 51, 0.08);
            }

            .input-group .input-group-prepend {
                height: 100%;
                background: transparent !important;
            }

            .input-group .input-group-text {
                width: 46px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border: 0 !important;
                background: transparent !important;
                transition: transform 0.3s ease;
            }

            .input-group:focus-within .input-group-text i {
                transform: scale(1.1);
            }

            .input-group .input-group-text i {
                color: var(--bjp-saffron-dark) !important;
                font-size: 20px;
                transition: transform 0.3s ease;
            }

            .input-group .form-control {
                height: 48px;
                padding: 0 14px 0 0;
                border: 0 !important;
                outline: none !important;
                box-shadow: none !important;
                background: transparent !important;
                font-size: 14px;
                color: var(--bjp-text-dark);
                font-weight: 500;
            }

                .input-group .form-control::placeholder {
                    color: #b0b8c8;
                    font-weight: 400;
                    font-size: 13px;
                }

        /* ===== LOGIN BUTTON ===== */
        .my-3 {
            margin-top: 6px !important;
            position: relative;
            z-index: 1;
        }

        #btnLogin {
            width: 100%;
            height: 52px;
            border: 0 !important;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--bjp-saffron) 0%, var(--bjp-saffron-dark) 100%) !important;
            color: #fff !important;
            font-weight: 700;
            font-size: 15px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(255, 153, 51, 0.25);
            position: relative;
            overflow: hidden;
        }

            #btnLogin::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 200%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
                transition: left 0.6s ease;
            }

            #btnLogin:hover::before {
                left: 100%;
            }

            #btnLogin:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 30px rgba(255, 153, 51, 0.35);
            }

            #btnLogin:active {
                transform: translateY(0);
            }

        /* ===== ERROR STATE ===== */
        .errortext {
            border: 2px solid #dc3545 !important;
            background-color: #fff5f5 !important;
        }

        /* ============================================================
           RESPONSIVE - SABHI SCREENS KE LIYE
           ============================================================ */

        /* ===== DESKTOP (min-width: 1200px) ===== */
        @@media (min-width: 1200px) {
            .mla-branding-left {
                min-height: 100vh;
            }

            .mla-login-right {
                min-height: 100vh;
            }
        }

        /* ===== TABLET (992px - 768px) ===== */
        @@media (min-width: 768px) and (max-width: 991.98px) {
            .mla-branding-left {
                min-height: 100vh;
                padding: 30px 25px;
            }

                .mla-branding-left .mla-left-logo img {
                    max-width: 100px;
                    max-height: 100px;
                    padding: 8px;
                }

                .mla-branding-left .mla-left-text h1 {
                    font-size: 26px;
                }

                .mla-branding-left .mla-left-text p {
                    font-size: 19px;
                }

                .mla-branding-left .mla-left-text span {
                    font-size: 15px;
                }

            .mla-login-right {
                min-height: 100vh;
                padding: 40px 24px;
            }

            .auth-form-transparent {
                max-width: 380px;
                padding: 35px 30px !important;
            }

            .brand-logo img {
                max-width: 160px;
                max-height: 60px;
            }
        }

        /* ===== MOBILE (max-width: 767px) ===== */
        @@media (max-width: 767.98px) {
            body {
                overflow-x: hidden;
            }

            .container-scroller {
                padding: 0;
                background: #FFFFFF;
                min-height: 100vh;
            }

                .container-scroller .content-wrapper {
                    min-height: 100vh;
                }

                .container-scroller .row {
                    min-height: 100vh;
                    flex-direction: column;
                }
            /* Left branding - top section */
            .mla-branding-left {
                min-height: 45vh;
                padding: 25px 20px;
                width: 100%;
                display: flex;
            }

                .mla-branding-left .mla-left-logo img {
                    max-width: 80px;
                    max-height: 80px;
                    padding: 6px;
                }

                .mla-branding-left .mla-left-text h1 {
                    font-size: 22px;
                    margin: 0 0 4px 0;
                }

                .mla-branding-left .mla-left-text p {
                    font-size: 17px;
                    margin: 0 0 3px 0;
                }

                .mla-branding-left .mla-left-text span {
                    font-size: 11px;
                    letter-spacing: 3px;
                }

                .mla-branding-left .mla-left-copyright {
                    position: relative;
                    margin-top: 15px;
                    bottom: auto;
                    left: auto;
                    right: auto;
                    padding-top: 10px;
                    border-top: 1px solid rgba(255, 255, 255, 0.06);
                    font-size: 10px;
                }
            /* Right login - bottom section */
            .mla-login-right {
                min-height: 55vh;
                padding: 20px 14px;
                width: 100%;
                display: flex;
            }

            .auth-form-transparent {
                max-width: 100%;
                padding: 28px 18px !important;
                border-radius: 16px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                border-right-width: 4px;
            }

            .brand-logo img {
                max-width: 150px;
                max-height: 60px;
            }

            .input-group {
                height: 46px;
                border-radius: 10px;
            }

                .input-group .input-group-text {
                    width: 40px;
                    height: 44px;
                }

                    .input-group .input-group-text i {
                        font-size: 17px;
                    }

                .input-group .form-control {
                    height: 44px;
                    font-size: 13px;
                }

            #btnLogin {
                height: 48px;
                font-size: 14px;
            }

            .form-group {
                margin-bottom: 15px;
            }

                .form-group label {
                    font-size: 12px;
                }
            /* Wave animation adjust for mobile */
            .mla-branding-left .wave {
                width: 300%;
                height: 300%;
                bottom: -20%;
                left: -100%;
            }
        }

        /* ===== SMALL MOBILE (max-width: 400px) ===== */
        @@media (max-width: 400px) {
            .mla-branding-left {
                min-height: 40vh;
                padding: 20px 15px;
            }

                .mla-branding-left .mla-left-logo img {
                    max-width: 65px;
                    max-height: 65px;
                    padding: 5px;
                }

                .mla-branding-left .mla-left-text h1 {
                    font-size: 18px;
                }

                .mla-branding-left .mla-left-text p {
                    font-size: 15px;
                }

                .mla-branding-left .mla-left-text span {
                    font-size: 10px;
                    letter-spacing: 2px;
                }

            .mla-login-right {
                min-height: 60vh;
                padding: 15px 10px;
            }

            .auth-form-transparent {
                padding: 20px 12px !important;
                border-radius: 12px;
            }

            .brand-logo img {
                max-width: 130px;
                max-height: 50px;
            }

            .input-group {
                height: 42px;
                border-radius: 8px;
            }

                .input-group .input-group-text {
                    width: 36px;
                    height: 40px;
                }

                    .input-group .input-group-text i {
                        font-size: 15px;
                    }

                .input-group .form-control {
                    height: 40px;
                    font-size: 12px;
                }

            #btnLogin {
                height: 44px;
                font-size: 13px;
            }

            .form-group {
                margin-bottom: 12px;
            }

                .form-group label {
                    font-size: 11px;
                }
        }

        /* ===== TABLET LANDSCAPE (max-height: 500px) ===== */
        @@media (max-height: 500px) and (orientation: landscape) {
            .mla-branding-left {
                min-height: 100vh;
                padding: 20px;
            }

                .mla-branding-left .mla-left-logo img {
                    max-width: 60px;
                    max-height: 60px;
                    padding: 5px;
                }

                .mla-branding-left .mla-left-text h1 {
                    font-size: 20px;
                    margin: 0 0 3px 0;
                }

                .mla-branding-left .mla-left-text p {
                    font-size: 16px;
                    margin: 0 0 2px 0;
                }

                .mla-branding-left .mla-left-text span {
                    font-size: 10px;
                }

            .mla-login-right {
                padding: 20px;
            }

            .auth-form-transparent {
                padding: 20px 18px !important;
            }

            .input-group {
                height: 38px;
            }

                .input-group .input-group-text {
                    width: 34px;
                    height: 36px;
                }

                    .input-group .input-group-text i {
                        font-size: 15px;
                    }

                .input-group .form-control {
                    height: 36px;
                    font-size: 12px;
                }

            #btnLogin {
                height: 38px;
                font-size: 12px;
            }

            .form-group {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    @using (Html.BeginForm("LoginAction", "Home", FormMethod.Post, new { @id = "Form" }))
    {
        <div class="container-scroller">
            <div class="container-fluid page-body-wrapper full-page-wrapper">
                <div class="content-wrapper d-flex align-items-stretch auth">
                    <div class="row flex-grow">

                        <!-- ===== LEFT - BRANDING WITH WAVE ANIMATION ===== -->
                        <div class="col-lg-6 d-flex flex-row mla-branding-left">

                            <!-- Wave Animation Container -->
                            <div class="wave-container">
                                <div class="wave"></div>
                                <div class="wave"></div>
                                <div class="wave"></div>
                                <div class="wave"></div>
                            </div>

                            <div class="mla-left-content">

                                <!-- Logo -->
                                <div class="mla-left-logo">
                                    <img src="/AssetsNew/images/favicon.png" alt="BJP Logo">
                                </div>

                                <!-- Text -->
                                <div class="mla-left-text">
                                    <h1>भारतीय जनता पार्टी</h1>
                                    <p>सुरेन्द्र चौरसिया</p>
                                    <span>विधायक, 339- विधानसभा रामपुर कारखाना (देवरिया)</span>
                                </div>
                            </div>

                            <!-- Copyright -->
                            @*<p class="mla-left-copyright">Copyright © 2023 Surendra Chaurasia, All Rights Reserved.</p>*@
                        </div>

                        <!-- ===== RIGHT - LOGIN FORM ===== -->
                        <div class="col-lg-6 d-flex align-items-center justify-content-center mla-login-right">
                            <div class="auth-form-transparent text-left p-3">

                                <div class="brand-logo">
                                    <img src="/images/logo.png" alt="logo">
                                </div>

                                <div>
                                    <h4>Admin Login</h4>
                                    <span style="color:red">@TempData["Login"]</span>
                                </div>
                               

                                <div class="pt-3">
                                    <div class="form-group">
                                        <label for="exampleInputEmail" class="mb-3">Username</label>
                                        <div class="input-group">
                                            <div class="input-group-prepend bg-transparent">
                                                <span class="input-group-text bg-transparent border-right-0">
                                                    <i class="mdi mdi-account-outline text-primary"></i>
                                                </span>
                                            </div>
                                            <input class="form-control form-control-lg border-left-0" type="text" id="LoginId" name="LoginId" placeholder="Username">
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="exampleInputPassword" class="mb-3">Password</label>
