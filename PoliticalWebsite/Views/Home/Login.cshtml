<script>
    function ValidateForm() {
        debugger;
        if ($("#LoginId").val() == "") {
            $("#LoginId").addClass('errortext');
            $("#LoginId").focus();
            return false;
        }
        else if ($("#Password").val() == "") {
            $("#Password").addClass('errortext');
            $("#Password").focus();
            return false;
        }
        return true;
    }
</script>

