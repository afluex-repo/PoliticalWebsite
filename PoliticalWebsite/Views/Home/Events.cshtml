@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "Events";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}

<!-- Page Header Start -->
<div class="page-header parallaxie">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-2" data-cursor="-opaque">हमारी फोटो गैलरी</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Home/Index">होम </a></li>
                            <li class="breadcrumb-item active" aria-current="page">हमारी फोटो गैलरी</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Our Blog Section Start -->
<div class="our-blog">
    <div class="container">

        <div class="row">

            @if (Model.lstevent != null && Model.lstevent.Count > 0)
            {
                foreach (var item in Model.lstevent)
                {
                    <div class="col-lg-4 col-md-6">

                        <!-- Post Item Start -->
                        <div class="post-item wow fadeInUp">

                            <!-- Post Featured Image Start -->
                            <div class="post-featured-image">
                                <a href="@item.EventImage" data-cursor-text="View">
                                    <figure class="image-anime">
                                        <img src="@item.EventImage"
                                             alt="@item.Discription">
                                    </figure>
                                </a>
                            </div>
                            <!-- Post Featured Image End -->
                            <!-- Blog Item Body Start -->
                            <div class="blog-item-body">

                                <!-- Post Item Content Start -->
                                <div class="post-item-content">
                                    <h2>
                                        <a href="@item.EventImage">
                                            @item.Discription
                                        </a>
                                    </h2>
                                </div>
                                <!-- Post Item Content End -->
                                <!-- Event Details -->
                                @*<div class="event-details">

                                        @if (!string.IsNullOrEmpty(item.Date))
                                        {
                                            <p>
                                                <strong>Date:</strong> @item.Date
                                            </p>
                                        }

                                        @if (!string.IsNullOrEmpty(item.City))
                                        {
                                            <p>
                                                <strong>City:</strong> @item.City
                                            </p>
                                        }

                                        @if (!string.IsNullOrEmpty(item.Town_Village))
                                        {
                                            <p>
                                                <strong>Town/Village:</strong> @item.Town_Village
                                            </p>
                                        }

                                    </div>*@

                                <!-- Blog Item Button Start -->
                                <div class="blog-item-btn">
                                    <a href="@item.EventImage"
                                       class="readmore-btn">
                                        और पढ़ें
                                    </a>
                                </div>
                                <!-- Blog Item Button End -->

                            </div>
                            <!-- Blog Item Body End -->

                        </div>
                        <!-- Post Item End -->

                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p>No events available.</p>
                </div>
            }

        </div>

    </div>
</div>
<!-- Our Blog Section End -->
