@{
    ViewBag.Title = "NewsPressRelease";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<!-- Page Header Start -->
<div class="page-header parallaxie">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-2" style="text-transform: capitalize;" data-cursor="-opaque">समाचार और प्रेस</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Home/Index">होम </a></li>
                            <li class="breadcrumb-item active" aria-current="page">समाचार और प्रेस</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<section id="blogSection" class="blog-section">

    <div class="container">

        <div class="row">

            <!-- Section Header -->
            <div class="col-12">
                <div class="blog-header text-center">

                    <span class="blog-tag">हमारे ब्लॉग</span>

                    <h2>
                        नवीनतम <span>अपडेट्स</span>
                    </h2>

                    <p>
                        सुरेन्द्र चौरसिया जी के विचार, योजनाएँ और समुदाय के लिए संदेश
                    </p>

                </div>
            </div>

        </div>


        <div class="row">

            @if (Model.lstNews != null && Model.lstNews.Count > 0)
            {
                foreach (var item in Model.lstNews)
                {
                    <div class="col-12">

                        <div class="blog-post-card">

                            <div class="row align-items-center">

                                <!-- Image -->
                                <div class="col-lg-3 col-md-4 col-sm-12">

                                    <div class="blog-image-wrapper">

                                        <img src="@item.NewsImage"
                                             alt="ब्लॉग पोस्ट"
                                             class="blog-image">

                                        <div class="blog-date-badge">

                                            @*<span class="date-day">
                                                @item.Day
                                            </span>*@

                                            @*<span class="date-month">
                                                @item.Month
                                            </span>*@

                                        </div>

                                        <div class="blog-category-tag">
                                            <span>समाचार</span>
                                        </div>

                                    </div>

                                </div>


                                <!-- Content -->
                                <div class="col-lg-9 col-md-8 col-sm-12">

                                    <div class="blog-content-wrapper">

                                        <!-- Meta -->
                                        <div class="blog-meta">

                                            <span class="meta-author">
                                                <i class="fas fa-user"></i>
                                                सुरेन्द्र चौरसिया
                                            </span>

                                            <span class="meta-category">
                                                <i class="fas fa-folder"></i>
                                                समाचार
                                            </span>

                                        </div>


                                        <!-- Title -->
                                        <h3 class="blog-title">

                                            <a href="@Url.Action("NewsDetails", "Home", new { id = item.Pk_NewsId })">
                                                @item.Discription
                                            </a>

                                        </h3>


                                        <!-- Description -->
                                        <p class="blog-excerpt">
                                            @item.Message
                                        </p>


                                        <!-- Footer -->
                                        <div class="blog-footer">

                                            <a href="@Url.Action("NewsDetails", "Home", new { id = item.Pk_NewsId })"
                                               class="blog-read-more">

                                                <span>और पढ़ें</span>

                                                <i class="fas fa-arrow-right"></i>

                                            </a>

                                            <span class="blog-read-time">

                                                <i class="fas fa-clock"></i>

                                                5 मिनट पढ़ें

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">

                    <div class="alert alert-info">
                        अभी कोई समाचार उपलब्ध नहीं है।
                    </div>

                </div>
            }


            <!-- View All -->
            <div class="col-12 text-center">

                <a href="@Url.Action("NewsPressRelease", "Home")"
                   class="blog-view-all">

                    <span>सभी ब्लॉग देखें</span>

                    <i class="fas fa-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>