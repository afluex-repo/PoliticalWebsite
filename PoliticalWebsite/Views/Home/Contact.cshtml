@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}

<!-- Page Header Start -->
<div class="page-header parallaxie">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">

                <div class="page-header-box">

                    <h1 class="text-anime-style-2" data-cursor="-opaque">
                        Contact us
                    </h1>

                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">

                            <li class="breadcrumb-item">
                                <a href="/Home/Index">
                                    home
                                </a>
                            </li>

                            <li class="breadcrumb-item active"
                                aria-current="page">
                                contact us
                            </li>

                        </ol>
                    </nav>

                </div>

            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Contact Section Start -->
<section class="contact-v2-section py-5">

    <div class="container">

        <!-- Heading -->
        <div class="row justify-content-center mb-5">

            <div class="col-lg-8 text-center">

                <div class="contact-heading">

                    <span class="sub-title">
                        संपर्क करें
                    </span>

                    <h2>
                        आइए, एक संवाद शुरू करें
                    </h2>

                    <p>
                        हम आपसे सुनना चाहते हैं। चाहे आपका कोई सवाल हो,
                        सुझाव हो, या आप हमसे जुड़ना चाहते हों,
                        बस नीचे दिए गए फॉर्म को भरें और हमारी टीम
                        जल्द ही आपसे संपर्क करेगी।
                    </p>

                </div>

            </div>

        </div>


        <!-- Success / Error Message -->

        @if (TempData["Contact"] != null)
        {
            <div class="row justify-content-center mb-4">

                <div class="col-lg-8">

                    <div class="alert alert-@(TempData["ContactType"] ?? "info") alert-dismissible fade show"
                         role="alert">

                        @TempData["Contact"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>

                    </div>

                </div>

            </div>
        }


        <div class="row g-4 align-items-stretch">


            <!-- =================================
                 Contact Form
            ================================== -->

            <div class="col-lg-7">

                <div class="contact-form-wrapper">


                    @using (Html.BeginForm(
                    "Contact",
                    "Home",
                    FormMethod.Post,
                    new
                    {
                        id = "form1",
                        enctype = "multipart/form-data"
                    }))
                    {
                        @Html.AntiForgeryToken()
                        {
                            <div class="row">

                                <!-- Name -->
                                <div class="col-md-6 mb-4">
                                    <label>पूरा नाम</label>

                                    @Html.TextBoxFor(m => m.Name, new
                               {
                                   @class = "form-control",
                                   placeholder = "अपना पूरा नाम दर्ज करें",
                                   required = "required"
                               })
                                </div>

                                <!-- Mobile -->
                                <div class="col-md-6 mb-4">
                                    <label>मोबाइल नंबर</label>

                                    @Html.TextBoxFor(m => m.Mobile, new
                               {
                                   @class = "form-control",
                                   type = "tel",
                                   placeholder = "अपना मोबाइल नंबर दर्ज करें",
                                   required = "required"
                               })
                                </div>

                                <!-- Email -->
                                <div class="col-md-6 mb-4">
                                    <label>ईमेल पता</label>

                                    @Html.TextBoxFor(m => m.Email, new
                               {
                                   @class = "form-control",
                                   type = "email",
                                   placeholder = "ईमेल दर्ज करें",
                                   required = "required"
                               })
                                </div>

                                <!-- Subject -->
                                <div class="col-md-6 mb-4">
                                    <label>विषय</label>

                                    @Html.TextBoxFor(m => m.Subject, new
                               {
                                   @class = "form-control",
                                   placeholder = "विषय दर्ज करें"
                               })
                                </div>

                                <!-- Message -->
                                <div class="col-12 mb-4">
                                    <label>आपका संदेश</label>

                                    @Html.TextAreaFor(m => m.Message, new
                               {
                                   @class = "form-control",
                                   rows = "6",
                                   placeholder = "अपना संदेश लिखें...",
                                   required = "required"
                               })
                                </div>

                                <!-- CAPTCHA -->
                                <div class="col-md-6 mb-4">
                                    <label>सुरक्षा जाँच</label>

                                    <div class="simple-captcha">
                                        <span id="captchaQuestion"></span>

                                        <button type="button"
                                                class="refresh-captcha"
                                                onclick="generateCaptcha()">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- CAPTCHA Answer -->
                                <div class="col-md-6 mb-4">
                                    <label>आपका उत्तर</label>

                                    <input type="number"
                                           id="captchaAnswer"
                                           name="CaptchaAnswer"
                                           class="form-control"
                                           placeholder="उत्तर दर्ज करें"
                                           required />
                                </div>

                                <!-- Save -->
                                <div class="col-12">
                                    <button type="submit"
                                            id="btnSave"
                                            name="btnSave"
                                            class="submit-btn">
                                        संदेश भेजें
                                        <i class="fas fa-paper-plane ms-2"></i>
                                    </button>
                                </div>

                            </div>
                        }
                    }


                    </div>

            </div>


            <!-- =================================
                 Right Side Contact Information
            ================================== -->

            <div class="col-lg-5">

                <div class="contact-right">


                    <!-- Phone -->
                    <div class="contact-info-box">

                        <div class="icon">

                            <i class="fas fa-phone-alt">
                            </i>

                        </div>

                        <div>

                            <h5>
                                फोन नंबर
                            </h5>

                            <p>
                                +91 94159 64410
                            </p>

                        </div>

                    </div>


                    <!-- Email -->
                    <div class="contact-info-box">

                        <div class="icon">

                            <i class="fas fa-envelope">
                            </i>

                        </div>

                        <div>

                            <h5>
                                ईमेल पता
                            </h5>

                            <p>
                                surendarchaurasia@gmail.com
                            </p>

                        </div>

                    </div>


                    <!-- Address -->
                    <div class="contact-info-box">

                        <div class="icon">

                            <i class="fas fa-map-marker-alt">
                            </i>

                        </div>

                        <div>

                            <h5>
                                कार्यालय का पता
                            </h5>

                            <p>
                                विधानसभा रामपुर कारखाना,
                                देवरिया, उत्तर प्रदेश, भारत
                            </p>

                        </div>

                    </div>


                    <!-- Map -->
                    <div class="contact-map">

                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14217.807488224102!2d83.8092502526931!3d26.57182882093928!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3993c481f3db6fdf%3A0x1082f79002006785!2sRampur%20Karkhana%2C%20Uttar%20Pradesh%20274405!5e1!3m2!1sen!2sin!4v1786013891609!5m2!1sen!2sin"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="strict-origin-when-cross-origin">
                        </iframe>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
<!-- Contact Section End -->
<!-- =================================
     CAPTCHA JavaScript
================================== -->

<script>

    let captchaResult = 0;


    // Generate CAPTCHA
    function generateCaptcha() {

        let num1 =
            Math.floor(Math.random() * 10) + 1;

        let num2 =
            Math.floor(Math.random() * 10) + 1;


        captchaResult =
            num1 + num2;


        document.getElementById("captchaQuestion").innerHTML =
            num1 + " + " + num2 + " = ?";


        document.getElementById("captchaAnswer").value = "";
    }


    // Generate CAPTCHA on page load
    generateCaptcha();


    // Form Submit Validation
    document.getElementById("form1").addEventListener(
        "submit",
        function (e) {

            const answer =
                parseInt(
                    document.getElementById("captchaAnswer").value
                );


            // CAPTCHA incorrect
            if (answer !== captchaResult) {

                e.preventDefault();

                alert(
                    "Incorrect CAPTCHA! Please try again."
                );

                generateCaptcha();

                return false;
            }


            // CAPTCHA correct
            // Form will automatically POST
            // to /Home/Contact

            return true;

        }
    );

</script>