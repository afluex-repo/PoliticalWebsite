@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "Gallery";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}
<!-- Page Header Start -->
<div class="page-header parallaxie">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-2" data-cursor="-opaque">हमारी फोटो गैलरी</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Home/Index">होम </a></li>
                            <li class="breadcrumb-item active" aria-current="page">हमारी फोटो गैलरी</li>
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>
<!-- Page Header End -->
<div class="our-gallery">
    <div class="container">

        <div class="row gallery-items">

            @if (Model.lstgallery != null && Model.lstgallery.Count > 0)
            {
                foreach (var item in Model.lstgallery)
                {
                    <div class="col-lg-3 col-6">

                        <!-- Photo Gallery Item Start -->
                        <div class="photo-gallery wow fadeInUp">

                            <a href="@item.GalleryImage"
                               data-cursor-text="View">

                                <figure class="image-anime">
                                    <img src="@item.GalleryImage"
                                         alt="@item.Discription">
                                </figure>

                            </a>

                        </div>
                        <!-- Photo Gallery Item End -->

                    </div>
                }
            }

        </div>

    </div>
</div>
<!-- Photo Gallery Section End -->
