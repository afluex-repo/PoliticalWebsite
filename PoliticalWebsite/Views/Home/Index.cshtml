@model PoliticalWebsite.Models.Home

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/WebsiteLayout.cshtml";
}

  



<!-- Hero Section Start -->
<div class="hero hero-video hero-slider-layout">

    <div class="swiper">

        <div class="swiper-wrapper">

            @if (Model.lstSliderBanner != null &&
                 Model.lstSliderBanner.Count > 0)
            {
                foreach (var item in Model.lstSliderBanner)
                {
                    <!-- Hero Slide Start -->
                    <div class="swiper-slide">

                        <div class="hero-slide">

                            <!-- Slider Image Start -->
                            <div class="hero-slider-image">

                                <img src="@Url.Content("~/images/" + item.SliderBannerImage)"
                                     alt="@item.Heading">

                            </div>
                            <!-- Slider Image End -->


                            <div class="container">

                                <div class="row align-items-center">

                                    <div class="col-lg-7">

                                        <!-- Hero Content Start -->
                                        <div class="hero-content">

                                            <!-- Section Title Start -->
                                            <div class="section-title dark-section">

                                                @if (!string.IsNullOrEmpty(item.Heading))
                                                {
                                                    <h3 class="wow fadeInUp">
                                                        @item.Heading
                                                    </h3>
                                                }

                                                @if (!string.IsNullOrEmpty(item.Title))
                                                {
                                                    <h1 class="text-anime-style-2"
                                                        data-cursor="-opaque">

                                                        @item.Title

                                                    </h1>
                                                }

                                                @if (!string.IsNullOrEmpty(item.Description))
                                                {
                                                    <p class="wow fadeInUp"
                                                       data-wow-delay="0.2s">

                                                        @item.Description

                                                    </p>
                                                }

                                            </div>
                                            <!-- Section Title End -->
                                            <!-- Hero Body Start -->
                                            @if (!string.IsNullOrEmpty(item.ButtonText))
                                            {
                                                <div class="hero-body wow fadeInUp"
                                                     data-wow-delay="0.4s">

                                                    <a href="@item.ButtonUrl"
                                                       class="btn-default btn-highlighted">

                                                        @item.ButtonText

                                                    </a>

                                                </div>
                                            }
                                            <!-- Hero Body End -->
                                            <!-- Hero Footer Start -->
                                            @if (!string.IsNullOrEmpty(item.FooterText))
                                            {
                                                <div class="hero-footer wow fadeInUp"
                                                     data-wow-delay="0.6s">

                                                    <p>
                                                        @item.FooterText
                                                    </p>

                                                </div>
                                            }
                                            <!-- Hero Footer End -->

                                        </div>
                                        <!-- Hero Content End -->

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- Hero Slide End -->
                }
            }

        </div>

        <div class="hero-pagination"></div>

    </div>

</div>
<!-- Hero Section End -->
<!-- About Us Section Start -->
<div class="about-us">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <!-- About Us Image Start -->
                <div class="about-us-image">
                    <!-- About Image Start -->
                    <div class="about-image">
                        <figure class="image-anime">
                            <img src="/AssetsNew/images/about-us-image.jpg" alt="">
                        </figure>
                    </div>
                    <!-- About Image End -->
                    <!-- About Image Info Start -->
                    <div class="about-image-info">
                        <h2>हमारे बारे में</h2>
                        <h3>एक बेहतर कल के लिए दूरदर्शी नेता</h3>
                        <p>- सुरेन्द्र चौरसिया</p>
                    </div>
                    <!-- About Image Info End -->
                </div>
                <!-- About Us Image End -->
            </div>

            <div class="col-lg-6">
                <!-- About Us Content Start -->
                <div class="about-us-content">
                    <!-- Section Title Start -->
                    <div class="section-title">
                        <!-- <h3 class="wow fadeInUp">हमारे बारे में</h3> -->
                        <h2 class="text-anime-style-2" data-cursor="-opaque">हमारा   <span>परिचय</span></h2>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">मेरा जन्म 22 जुलाई 1989 को देवरिया जिले के ग्राम कुशहरी में एक साधारण परिवार में हुआ था। अखिल भारतीय विद्यार्थी परिषद से जुड़कर छात्र राजनीति की शुरुआत की और फिर उत्तर प्रदेश के मुख्यमंत्री योगी आदित्यनाथ के मार्गदर्शन में हिंदुत्व की विचारधारा को अपनाते हुए हिंदू युवा वाहिनी में शामिल हो गए। सुरेन्द्र चौरसिया जी वर्तमान में 339- विधानसभा रामपुर कारखाना (देवरिया) के विधायक है </p>
                        <p class="wow fadeInUp" data-wow-delay="0.2s">सुरेन्द्र चौरसिया जी सभी लोगों के बीच में लोकप्रिय हैं। अपने कार्यालय में चौरसिया जी जनसुनवाई करके विधानसभा के लोगो की समस्याओं का निवारण करते हैं। उनकी कार्य प्रणाली और आम आदमी के प्रति संवेदनशीलता ने उन्हें एक विशेष दर्जा दिया और उन्हें जनता के बीच जनता के नेता के रूप में बहुत लोकप्रिय बना दिया। चौरसिया जी द्वारा जनता दर्शन कार्यक्रम में आने वाले सभी लोगों तथा कुछ खास समूहों जैसे दिव्यांगों, वरिष्ठ नागरिकों व महिलाओं की समस्याओं को विशेष वरीयता दी जाती है |</p>
                    </div>
                    <!-- Section Title End -->
                    <!-- About Us List Start -->
                    <div class="about-us-list wow fadeInUp" data-wow-delay="0.4s">
                        <ul>
                            <li>सभी के लिए गुणवत्तापूर्ण शिक्षा और कौशल विकास</li>
                            <li>सस्ती स्वास्थ्य सेवा जो लोगों को मुनाफे से अधिक प्राथमिकता देती है</li>
                            <li>हर समुदाय के लिए समानता, न्याय और सुरक्षा</li>
                            <li>मजबूत, लचीला समुदायों के निर्माण के लिए बुनियादी ढांचे में निवेश</li>
                        </ul>
                    </div>
                    <!-- About Us List End -->
                    <!-- About Author Info Start -->
                    <div class="about-author-info wow fadeInUp" data-wow-delay="0.6s">
                        <h3>सुरेन्द्र चौरसिया </h3>
                        <h4 class="h6">विधायक, 339- विधानसभा रामपुर कारखाना (देवरिया) </h4>
                    </div>
                    <!-- About Author Info End -->
                </div>
                <!-- About Us Content End -->
            </div>
        </div>
    </div>
</div>
<!-- About Us Section End -->
<!-- Our Campaign Section Start -->
<div class="our-campaign">
    <div class="container">
        <div class="row section-row align-items-center">
            <div class="col-lg-6">
                <!-- Section Title Start -->
                <div class="section-title section-title-left">
                    <h3 class="wow fadeInUp">हमारा अभियान</h3>
                    <h2 class="text-anime-style-2" data-cursor="-opaque">हमारा मिशन: एक <span>बेहतर कल</span> का निर्माण</h2>
                </div>
                <!-- Section Title End -->
            </div>

            <div class="col-lg-6">
                <!-- Section Title Content Start -->
                <div class="section-title-content wow fadeInUp" data-wow-delay="0.2s">
                    <p>हमारे मिशन के केंद्र में समुदाय की शक्ति में अटूट विश्वास है। हम एक ऐसी दुनिया बनाने के लिए प्रतिबद्ध हैं जहां अवसर, समानता और न्याय सभी के लिए सुलभ हो, और हम इस दृष्टि को वास्तविकता में बदलने के लिए अथक प्रयास कर रहे हैं।</p>
                </div>
                <!-- Section Title Content End -->
            </div>
        </div>


        <div class="row ram-campaign-section">
            <div class="col-lg-12">

                <div class="campaign-list wow fadeInUp">

                    <!-- Campaign 1 -->
                    <div class="campaign-item">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="icon-orange" d="M7 25L32 8L57 25H7Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-green" d="M12 54H52M16 27V51M26 27V51M38 27V51M48 27V51" stroke-width="3" stroke-linecap="round" />
                                    <path class="icon-black" d="M7 56H57" stroke-width="3" stroke-linecap="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>विधानसभा का विकास, एक ही संकल्प</h3>
                                <p>रामपुर कारखाना का विकास हमारा संकल्प है। बेहतर सड़कें, यातायात, बिजली, शिक्षा और स्वास्थ्य सेवाएँ उपलब्ध कराना तथा सरकारी योजनाओं का लाभ सभी तक पहुँचाना हमारी प्राथमिकता है।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Campaign 2 -->
                    <div class="campaign-item active">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="icon-orange" d="M32 54S8 40 8 23C8 8 27 5 32 21C37 5 56 8 56 23C56 40 32 54 32 54Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-green" d="M32 22V40M23 31H41" stroke-width="4" stroke-linecap="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>स्वास्थ्य सेवा</h3>
                                <p>प्रत्येक व्यक्ति को बेहतर स्वास्थ्य सेवाएँ उपलब्ध कराना हमारा उद्देश्य है। मुख्यमंत्री राहत कोष के माध्यम से जरूरतमंदों को आर्थिक सहायता दिलाकर निःशुल्क इलाज कराने का प्रयास हमारी प्राथमिकता है।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Campaign 3 -->
                    <div class="campaign-item">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="icon-orange" d="M32 20C24 13 13 13 6 17V51C15 47 24 47 32 54C40 47 49 47 58 51V17C51 13 40 13 32 20Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-green" d="M32 20V54M13 25C18 24 23 25 27 28M51 25C46 24 41 25 37 28" stroke-width="3" stroke-linecap="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>शिक्षा सुधार</h3>
                                <p>गुणवत्तापूर्ण शिक्षा और समान अवसर उपलब्ध कराना हमारी प्राथमिकता है। नई लाइब्रेरी, खेल अकादमी एवं कस्तूरबा इंटर कॉलेज का निर्माण और शिक्षा सुविधाओं का विस्तार हमारी प्रमुख पहल है।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Campaign 4 -->
                    <div class="campaign-item">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle class="icon-orange" cx="32" cy="15" r="7" stroke-width="3" />
                                    <circle class="icon-green" cx="12" cy="24" r="6" stroke-width="3" />
                                    <circle class="icon-green" cx="52" cy="24" r="6" stroke-width="3" />
                                    <path class="icon-orange" d="M17 54V46C17 37 23 32 32 32C41 32 47 37 47 46V54H17Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-black" d="M4 49V44C4 38 8 34 14 34M60 49V44C60 38 56 34 50 34" stroke-width="3" stroke-linecap="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>समाज सेवा</h3>
                                <p>समाज सेवा और सामाजिक एकजुटता के माध्यम से जनसमस्याओं का समाधान करना तथा सामूहिक प्रयासों से सकारात्मक बदलाव लाना हमारा दायित्व है और समाज को मजबूत बनाना है।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Campaign 5 -->
                    <div class="campaign-item">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path class="icon-orange" d="M7 12H43C47 12 50 15 50 19V36C50 40 47 43 43 43H25L14 52V43H7C3 43 1 40 1 36V19C1 15 3 12 7 12Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-green" d="M23 25H36M23 33H41" stroke-width="3" stroke-linecap="round" />
                                    <path class="icon-black" d="M43 49H49L57 56V49H59C61 49 63 47 63 44V29C63 26 61 24 58 24H55" stroke-width="3" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>जन सुनवाई</h3>
                                <p>रामपुर कारखाना का सर्वांगीण विकास हमारा संकल्प है। जनसमस्याओं का समाधान, बेहतर सुविधाएँ और सरकारी योजनाओं का लाभ प्रत्येक नागरिक तक पहुँचाना हमारी प्राथमिकता है।</p>
                            </div>
                        </div>
                    </div>

                    <!-- Campaign 6 -->
                    <div class="campaign-item">
                        <div class="campaign-image">
                            <img src="/AssetsNew/images/campaign-1.jpg" alt="">
                        </div>

                        <div class="campaign-content">
                            <div class="campaign-icon">
                                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <circle class="icon-orange" cx="32" cy="13" r="7" stroke-width="3" />
                                    <circle class="icon-green" cx="13" cy="24" r="6" stroke-width="3" />
                                    <circle class="icon-green" cx="51" cy="24" r="6" stroke-width="3" />
                                    <path class="icon-orange" d="M32 25L23 34L32 43L41 34L32 25Z" stroke-width="3" stroke-linejoin="round" />
                                    <path class="icon-green" d="M5 51C5 42 11 37 19 37M59 51C59 42 53 37 45 37M19 55C19 47 24 43 32 43C40 43 45 47 45 55" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div class="campaign-content-info">
                                <h3>जनता के साथ, जनता के लिए</h3>
                                <p>जनता की समस्याओं को समझना, उनकी आवाज़ बनना और हर जरूरत में साथ खड़े रहना हमारा संकल्प है। जनसहयोग और सामूहिक प्रयासों से क्षेत्र में सकारात्मक बदलाव लाना हमारी प्राथमिकता है।</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>
<!-- Our Campaign Section End -->
