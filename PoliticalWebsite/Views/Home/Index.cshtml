<!-- Our Blog Section Start -->
<div class="our-blog">
    <div class="container">
        <div class="row section-row align-items-center">
            <div class="col-lg-6">
                <!-- Section Title Start -->
                <div class="section-title section-title-left">
                    <!-- <h3 class="wow fadeInUp">नवीनतम पोस्ट</h3> -->
                    <h2 class="text-anime-style-2" style="text-transform: capitalize;" data-cursor="-opaque">नवीनतम समाचार  <span>और प्रेस</span> </h2>
                </div>
                <!-- Section Title End -->
            </div>

            <div class="col-lg-6">
                <!-- Section Title Content Start -->
                <div class="section-title-content wow fadeInUp" data-wow-delay="0.4s">
                    <p>नवीनतम समाचारों, अंतर्दृष्टियों और घटनाक्रमों के साथ अपडेट रहें। हमारे पोस्ट नीति परिवर्तनों और सामाजिक मुद्दों से लेकर सामुदायिक पहलों और आगामी कार्यक्रमों तक सब कुछ कवर करते हैं।</p>
                </div>
                <!-- Section Title Content End -->
            </div>
        </div>

        <div class="row">
            @if (Model.lstNews != null && Model.lstNews.Count > 0)
            {
                foreach (var item in Model.lstNews)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="post-item wow fadeInUp">

                            <!-- Image -->
                            <div class="post-featured-image">

                                <a href="#!" data-cursor-text="View">

                                    <figure class="image-anime">

                                        <img src="@Url.Content(item.NewsImage)"
                                             alt="@item.Discription">

                                    </figure>

                                </a>

                            </div>


                            <!-- Body -->
                            <div class="blog-item-body">

                                <!-- Title -->
                                <div class="post-item-content">

                                    <h2>
                                        <a href="#!">
                                            @item.Discription
                                        </a>
                                    </h2>

                                    @*<p>
                                        @item.Message
                                    </p>*@

                                    @*<small>
                                            @item.Date @item.Year
                                        </small>*@

                                </div>


                                <!-- Read More -->
                                <div class="blog-item-btn">

                                    @*<a href="/Home/BlogDetails" class="readmore-btn">
                                            और पढ़ें
                                        </a>*@
                                    <a href="@Url.Action("BlogDetails", "Home", new { id = item.Pk_NewsId })"
                                       class="blog-read-more">

                                        <span>और पढ़ें</span>

                                        <i class="fas fa-arrow-right"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p>अभी कोई समाचार उपलब्ध नहीं है।</p>
                </div>
            }

        </div>
    </div>
</div>
<!-- Our Blog Section End -->